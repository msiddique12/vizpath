# Database
DATABASE_URL=postgresql://vizpath:vizpath@localhost:5433/vizpath
POSTGRES_HOST_PORT=5433

# Redis
REDIS_URL=redis://localhost:6380
REDIS_HOST_PORT=6380

# Server
DEBUG=true
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
AUTO_CREATE_TABLES=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SECURITY_STRICT_MODE=false
ALLOW_UNAUTHENTICATED_DEV_FALLBACK=false
ENFORCE_MIGRATION_HEAD=false
ALERT_WEBHOOK_ALLOW_PRIVATE_TARGETS=false
# Required to store alert destination secret tokens securely (Fernet key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ALERT_SECRET_ENCRYPTION_KEY=
ALERT_NOTIFICATION_ASYNC_ENABLED=true
ALERT_NOTIFICATION_QUEUE_MAXSIZE=1000
ALERT_NOTIFICATION_MAX_RETRIES=3
ALERT_NOTIFICATION_RETRY_BACKOFF_SECONDS=0.5
ALERT_DEAD_LETTER_REPLAY_MAX_ATTEMPTS=3
ALERT_DEAD_LETTER_REPLAY_COOLDOWN_SECONDS=60

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=120
RATE_LIMIT_IP_RPM=240
RATE_LIMIT_USER_RPM=120
RATE_LIMIT_BURST_MULTIPLIER=1.0

# Trace retention (days)
TRACE_RETENTION_ENABLED=true
TRACE_RETENTION_DAYS=7
TRACE_RETENTION_SWEEP_INTERVAL_SECONDS=3600

# NVIDIA NIM (required for intelligence features)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5

# Optional: OpenAI (legacy, not required)
# OPENAI_API_KEY=your_openai_api_key_here
