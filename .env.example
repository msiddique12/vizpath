# Database
DATABASE_URL=postgresql://vizpath:vizpath@localhost:5432/vizpath

# Redis
REDIS_URL=redis://localhost:6379

# Server
DEBUG=true
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
AUTO_CREATE_TABLES=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SECURITY_STRICT_MODE=false

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=120
RATE_LIMIT_IP_RPM=240
RATE_LIMIT_USER_RPM=120
RATE_LIMIT_BURST_MULTIPLIER=1.0

# Trace retention (days)
TRACE_RETENTION_DAYS=7

# NVIDIA NIM (required for intelligence features)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: OpenAI (legacy, not required)
# OPENAI_API_KEY=your_openai_api_key_here
